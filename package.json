{
  "name": "ropcode",
  "version": "0.2.4",
  "private": true,
  "license": "AGPL-3.0",
  "description": "GUI app and Toolkit for Claude Code",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "npm run build:cli && ./scripts/dev-wails.sh",
    "dev:no-hmr": "npm run build:cli && ROPCODE_NO_HMR=1 ./scripts/dev-wails.sh",
    "dev:electron": "npm run build:go && concurrently \"npm run dev:frontend\" \"npm run dev:electron:shell\" --kill-others",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:frontend:no-hmr": "cd frontend && ROPCODE_NO_HMR=1 npm run dev",
    "dev:electron:shell": "cd electron && npm run build && npm run dev",
    "build:cli": "./scripts/build-cli.sh",
    "build:cli:dev": "go build -o bin/ropcode ./cmd/ropcode",
    "build:go": "go build -tags server -o bin/ropcode-server . && ./scripts/build-cli.sh",
    "build": "npm run build:frontend && wails build -tags wails",
    "build:frontend": "cd frontend && npm run build",
    "build:release": "./scripts/build-wails-dmg.sh",
    "build:release:electron": "./scripts/build-electron.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^26.0.0"
  },
  "author": {
    "name": "Ropcode",
    "email": "support@ropcode.com"
  },
  "homepage": "https://ropcode.com"
}
